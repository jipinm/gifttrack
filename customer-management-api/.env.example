# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=customer_management_db
DB_USER=root
DB_PASS=

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_ISSUER=customer-management-api
JWT_AUDIENCE=customer-management-mobile
JWT_EXPIRY=2592000

# API Configuration
API_VERSION=v1
ENVIRONMENT=development

# CORS Configuration
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# Timezone
TIMEZONE=Asia/Kolkata
